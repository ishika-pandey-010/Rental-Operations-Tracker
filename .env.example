# Copy to .env.local and fill in. `make setup` writes local values for you.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by scripts/seed.mjs, never by the app.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL, used by the database tests and the seed script.
DATABASE_URL=
# Display only: one currency per account (PRD §8). ISO 4217 code.
NEXT_PUBLIC_CURRENCY=
# IANA timezone that decides what "today" is for the reports, e.g. Europe/London.
APP_TIMEZONE=
